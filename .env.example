# Postgres on host port 5433 (compose maps 5433→5432; avoids clashing with other local DBs on 5432)
DATABASE_URL=postgresql://ali:ali@localhost:5433/ali?schema=public

# API
API_PORT=3001
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3002
DEMO_USER_EMAIL=demo@saasquatch.local

# Web (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Optional LLM enrichment — leave noop for assessment (never invents company facts)
# AI_PROVIDER=noop | openai | openrouter
AI_PROVIDER=noop
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
ENRICH_MAX_CANDIDATES=15
ENRICH_FETCH_TIMEOUT_MS=8000
# Set to 1 only if the chosen model supports response_format json_object
OPENROUTER_JSON_OBJECT=

# Catalog AI enrichment (full company list — weekly job / POST /enrichment/batch)
# Search scoring reads persisted DNA; set ENRICH_ON_SEARCH=true only for ad-hoc unstamped fills
ENRICH_ON_SEARCH=false
ENRICH_BATCH_LIMIT=50
ENRICH_BATCH_DELAY_MS=500
ENRICH_BATCH_TIMEOUT_MS=600000
