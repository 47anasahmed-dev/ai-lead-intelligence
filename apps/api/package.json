{
  "name": "@ali/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev --name init",
    "prisma:seed": "tsx prisma/seed.ts",
    "import:csv": "tsx scripts/import-csv.ts",
    "smoke": "tsx scripts/smoke-reference.ts"
  },
  "dependencies": {
    "@ali/shared": "workspace:*",
    "@fastify/cors": "^10.0.1",
    "@prisma/client": "^6.1.0",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
